# =====================================================================
# ملتقى المسك القرآني — متغيرات البيئة
# محليًا: انسخ هذا الملف إلى  server/.env  (أو .env في جذر المشروع) وعبّئ القيم
# على Render: أدخل نفس المتغيرات في Environment (لا ترفع ملف .env إلى GitHub)
# =====================================================================

# رابط قاعدة بيانات Supabase  (Project Settings → Database → Connection string → "Session pooler")
# مهم: استبدل [YOUR-PASSWORD] بكلمة مرور قاعدة البيانات. إن احتوت رموزًا خاصة (@ # / :) رمّزها (URL-encode).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# مفتاح توقيع الجلسات — 32 حرفًا فأكثر وعشوائي. لتوليده:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# مفتاح تشفير كلمات مرور المشرفين التي يعرضها المسؤول ورمز ربط Google (غيّره = تضيع القيم المشفرة ويمكن إعادة توليدها/ربطها)
CREDENTIALS_KEY=

# حساب المسؤول الإداري (يُنشأ تلقائيًا عند أول تشغيل إن لم يكن موجودًا)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=المسؤول الإداري
# إن نسيت كلمة مرور المسؤول: ضع كلمة جديدة في ADMIN_PASSWORD و ADMIN_FORCE_RESET=true ثم أعد التشغيل، ثم أزل السطر.
# ADMIN_FORCE_RESET=true

# المنطقة الزمنية المستخدمة لساعات الدوام وحدود الأيام والتقارير
APP_TIMEZONE=Asia/Hebron

# المنفذ (Render يضبطه تلقائيًا)
PORT=4000

# الرابط العام للمنصة (لروابط البريد). على Render يُستنتج تلقائيًا من RENDER_EXTERNAL_URL إن تُرك فارغًا.
# APP_URL=https://masak-quran-forum.onrender.com

# اختياري: فقط إن شغّلت الواجهة من نطاق مختلف عن الـ API
# CLIENT_ORIGIN=https://your-frontend.example.com

NODE_ENV=development

# ---------------------------------------------------------------------
# المهام المجدولة (Supabase Cron → POST /api/cron/tick)
# سر عشوائي طويل (24 حرفًا فأكثر). نفس القيمة تُوضع في database/supabase_cron.sql
# بدونه تبقى نقطة الجدولة الخارجية معطلة (وتعمل المهام داخل الخادم أثناء نشاطه فقط).
CRON_SECRET=
# تشغيل المهام داخل الخادم أيضًا أثناء نشاطه (مساعد إضافي، الافتراضي true)
# IN_PROCESS_SCHEDULER=true

# ---------------------------------------------------------------------
# البريد الإلكتروني — Google Apps Script (MailApp) من حساب الملتقى misk.quran26@gmail.com
# بلا SMTP وبلا App Passwords وبلا خدمة مدفوعة. خطوات الإعداد: GOOGLE_EMAIL_SETUP.txt
# اتركه false حتى تنشر Apps Script؛ الإشعارات تبقى داخل المنصة دائمًا.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=google_apps_script
# رابط نشر الـ Web App (ينتهي بـ /exec)
GAS_WEB_APP_URL=
# سر مشترك عشوائي (32 حرفًا فأكثر) — نفس القيمة في Script Properties باسم GAS_SHARED_SECRET
# لتوليده:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAS_SHARED_SECRET=
EMAIL_REPLY_TO=misk.quran26@gmail.com
# الحد اليومي للرسائل (حساب Gmail الشخصي: 100 مستلم يوميًا كحد أقصى)
# EMAIL_DAILY_LIMIT=90
# مهلة بين الرسائل بالمللي ثانية (لتجنب نمط الإرسال الجماعي)
# EMAIL_SEND_INTERVAL_MS=3000
# الحساب المتوقع للنشر (للعرض والتحقق في صفحة الإعدادات)
# EMAIL_SENDER_ADDRESS=misk.quran26@gmail.com

# ---------------------------------------------------------------------
# Google Forms / Sheets (OAuth Client من Google Cloud Console — مجاني)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# يجب أن يطابق "Authorized redirect URI" في Google Cloud. الافتراضي: APP_URL + /api/google/oauth/callback
# GOOGLE_REDIRECT_URI=https://masak-quran-forum.onrender.com/api/google/oauth/callback
